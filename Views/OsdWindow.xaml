<Window x:Class="PincabVolume.Views.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False" Focusable="False" IsHitTestVisible="False"
        SizeToContent="WidthAndHeight" FontFamily="Segoe UI Variable Display, Segoe UI">
    <!-- Margin leaves room for the drop shadow -->
    <Grid Margin="28">
        <Grid.LayoutTransform>
            <TransformGroup>
                <ScaleTransform x:Name="ScaleT" />
                <RotateTransform x:Name="RotT" />
            </TransformGroup>
        </Grid.LayoutTransform>
        <Border CornerRadius="20" Padding="22,16" MinWidth="400" BorderThickness="1" BorderBrush="#30FFFFFF">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F21B1F2E" Offset="0" />
                    <GradientStop Color="#F20E1018" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.7" />
            </Border.Effect>
            <StackPanel>
                <DockPanel>
                    <TextBlock x:Name="TableText" DockPanel.Dock="Right" Foreground="#8B92A6" FontSize="13"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="260"
                               Margin="16,0,0,0" />
                    <TextBlock x:Name="ProfileText" Foreground="White" FontSize="18" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="84" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="IconText" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="28"
                               Foreground="#39D0FF" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Height="12" CornerRadius="6" Background="#26FFFFFF"
                            VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="FillCol" Width="50*" />
                                <ColumnDefinition x:Name="RestCol" Width="50*" />
                            </Grid.ColumnDefinitions>
                            <Border CornerRadius="6">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#39D0FF" Offset="0" />
                                        <GradientStop Color="#B65CFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect Color="#39D0FF" BlurRadius="10" ShadowDepth="0" Opacity="0.6" />
                                </Border.Effect>
                            </Border>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="PctText" Grid.Column="2" Foreground="White" FontSize="28" FontWeight="Bold"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
