<UserControl x:Class="PincabVolume.Views.BindingPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button x:Name="Pick" Click="Pick_Click" HorizontalContentAlignment="Stretch" Padding="9,4"
                ToolTip="Click, then press a key / key combo or gamepad buttons">
            <DockPanel>
                <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" Margin="0,0,9,0" FontSize="13" />
                <TextBlock x:Name="Caption" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Button>
        <Button x:Name="Clear" Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE711;"
                Margin="4,0,0,0" ToolTip="Clear" Click="Clear_Click" />
    </Grid>
</UserControl>
