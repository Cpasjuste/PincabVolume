<Window x:Class="PincabVolume.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:PincabVolume.Views"
        xmlns:c="clr-namespace:PincabVolume.Converters"
        x:Name="Root" Title="Pincab Volume" Width="780" Height="470" MinWidth="700" MinHeight="450"
        WindowStartupLocation="CenterScreen" Style="{StaticResource AppWindow}">
    <Window.Resources>
        <c:ActiveProfileConverter x:Key="ActiveProfile" />
        <Style x:Key="TabHeaderIcon" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="VDivider" TargetType="Rectangle">
            <Setter Property="Width" Value="1" />
            <Setter Property="Fill" Value="{StaticResource BorderBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="EmptyHint" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
    </Window.Resources>

    <Grid Margin="14,12,14,12">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl>
            <!-- ================================ Profiles ================================ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TabHeaderIcon}" Text="&#xE767;" />
                        <TextBlock Text="Profiles" />
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="29" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="2,0,0,6">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource IconButton}" Content="&#xE710;" ToolTip="Add profile"
                                        Click="AddProfile_Click" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE74D;"
                                        ToolTip="Remove selected profile" Click="RemoveProfile_Click" />
                            </StackPanel>
                            <TextBlock Text="AUDIO PROFILES" Style="{StaticResource Caption}" />
                        </DockPanel>
                        <Grid>
                            <ListBox x:Name="ProfileList" ItemsSource="{Binding Profiles}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <Ellipse DockPanel.Dock="Right" Width="7" Height="7" Margin="6,0,0,0"
                                                     Fill="{StaticResource SuccessBrush}" ToolTip="Active profile">
                                                <Ellipse.Visibility>
                                                    <MultiBinding Converter="{StaticResource ActiveProfile}">
                                                        <Binding Path="Id" />
                                                        <Binding Path="DataContext.ActiveProfileId"
                                                                 RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    </MultiBinding>
                                                </Ellipse.Visibility>
                                            </Ellipse>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="No profile yet.&#x0a;Click + to add one." Visibility="Collapsed">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyHint}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Items.Count, ElementName=ProfileList}"
                                                         Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DockPanel>

                    <Rectangle Grid.Column="1" Style="{StaticResource VDivider}" />

                    <!-- Selected profile editor -->
                    <Grid Grid.Column="2" DataContext="{Binding SelectedItem, ElementName=ProfileList}">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="84" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Column="1" Margin="0,0,0,8"
                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="1" Text="Device" Style="{StaticResource FieldLabel}" />
                        <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;"
                                    Margin="4,0,0,0" ToolTip="Refresh device list" Click="RefreshDevices_Click" />
                            <ComboBox ItemsSource="{Binding Devices, ElementName=Root}" DisplayMemberPath="Name"
                                      SelectedValuePath="Id" SelectedValue="{Binding DeviceId}" />
                        </DockPanel>

                        <TextBlock Grid.Row="2" Text="Hold key" Style="{StaticResource FieldLabel}"
                                   ToolTip="Optional. When set, Volume +/− only act on this profile while this key or button is held — handy to drive several devices with the same buttons." />
                        <v:BindingPicker Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Value="{Binding HoldKey}" />

                        <TextBlock Grid.Row="3" Text="Volume +" Style="{StaticResource FieldLabel}" />
                        <v:BindingPicker Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" Value="{Binding VolUp}" />

                        <TextBlock Grid.Row="4" Text="Volume −" Style="{StaticResource FieldLabel}" />
                        <v:BindingPicker Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" Value="{Binding VolDown}" />

                        <TextBlock Grid.Row="5" Text="Step" Style="{StaticResource FieldLabel}" />
                        <DockPanel Grid.Row="5" Grid.Column="1" Margin="0,0,0,8">
                            <TextBox DockPanel.Dock="Right" Style="{StaticResource ValueBox}" Text="{Binding Step}" />
                            <Slider Minimum="1" Maximum="10" IsSnapToTickEnabled="True" TickFrequency="1"
                                    Value="{Binding Step}" />
                        </DockPanel>

                        <TextBlock Grid.Row="6" Text="Max volume" Style="{StaticResource FieldLabel}" />
                        <DockPanel Grid.Row="6" Grid.Column="1" Margin="0,0,0,8">
                            <TextBox DockPanel.Dock="Right" Style="{StaticResource ValueBox}"
                                     Text="{Binding MaxVolume}" />
                            <Slider Minimum="10" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="5"
                                    Value="{Binding MaxVolume}" />
                        </DockPanel>

                        <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button Click="TestDown_Click" ToolTip="Lower this device's volume by one step">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE993;" Margin="0,0,6,0" />
                                    <TextBlock Text="Test −" />
                                </StackPanel>
                            </Button>
                            <Button Click="TestUp_Click" Margin="6,0,0,0"
                                    ToolTip="Raise this device's volume by one step">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE995;" Margin="0,0,6,0" />
                                    <TextBlock Text="Test +" />
                                </StackPanel>
                            </Button>
                            <Button Click="SetActive_Click" Margin="6,0,0,0"
                                    ToolTip="The active profile's volume is shown on the OSD when a table starts">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" Margin="0,0,6,0"
                                               Foreground="{StaticResource SuccessBrush}" />
                                    <TextBlock Text="Set active" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <TextBlock Grid.Column="2" Text="Select or add a profile to edit it.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyHint}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedItem, ElementName=ProfileList}"
                                                 Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </TabItem>

            <!-- ================================ OSD ================================ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TabHeaderIcon}" Text="&#xE7F4;" />
                        <TextBlock Text="OSD" />
                    </StackPanel>
                </TabItem.Header>
                <Grid DataContext="{Binding Osd}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="29" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="72" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Enabled" Style="{StaticResource FieldLabel}" />
                        <CheckBox Grid.Column="1" Margin="0,5,0,13" Content="Show on volume change"
                                  IsChecked="{Binding Enabled}" />

                        <TextBlock Grid.Row="1" Text="Monitor" Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"
                                  ItemsSource="{Binding Monitors, ElementName=Root}"
                                  SelectedIndex="{Binding MonitorIndex}" />

                        <TextBlock Grid.Row="2" Text="Rotation" Style="{StaticResource FieldLabel}" />
                        <ListBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,4" Style="{StaticResource ChipList}"
                                 ItemsSource="{Binding Rotations, ElementName=Root}"
                                 SelectedItem="{Binding Rotation}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource ChipItem}">
                                    <Setter Property="Width" Value="46" />
                                    <Setter Property="Padding" Value="0,4" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat={}{0}°}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Grid.Row="3" Text="Position" Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Top" Margin="0,4,12,0" />
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                            <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding Anchors, ElementName=Root}"
                                     SelectedItem="{Binding Anchor}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource ChipItem}">
                                        <Setter Property="Width" Value="34" />
                                        <Setter Property="Height" Value="22" />
                                        <Setter Property="ToolTip" Value="{Binding}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="6" Height="6"
                                                 Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Style="{StaticResource Hint}" Width="130" Margin="10,2,0,0"
                                       Text="Anchor on screen. Offsets push the OSD away from that edge (negative values pull it inward)." />
                        </StackPanel>
                    </Grid>

                    <Rectangle Grid.Column="1" Style="{StaticResource VDivider}" />

                    <Grid Grid.Column="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="72" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Offset X" Style="{StaticResource FieldLabel}" />
                        <DockPanel Grid.Column="1" Margin="0,0,0,8">
                            <TextBox DockPanel.Dock="Right" Style="{StaticResource ValueBox}"
                                     Text="{Binding OffsetX}" />
                            <Slider Minimum="-1500" Maximum="1500" SmallChange="1" LargeChange="10"
                                    IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding OffsetX}" />
                        </DockPanel>

                        <TextBlock Grid.Row="1" Text="Offset Y" Style="{StaticResource FieldLabel}" />
                        <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                            <TextBox DockPanel.Dock="Right" Style="{StaticResource ValueBox}"
                                     Text="{Binding OffsetY}" />
                            <Slider Minimum="-1500" Maximum="1500" SmallChange="1" LargeChange="10"
                                    IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding OffsetY}" />
                        </DockPanel>

                        <TextBlock Grid.Row="2" Text="Scale" Style="{StaticResource FieldLabel}" />
                        <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,8">
                            <TextBox DockPanel.Dock="Right" Style="{StaticResource ValueBox}"
                                     Text="{Binding Scale, StringFormat=0.00}" />
                            <Slider Minimum="0.5" Maximum="4" IsSnapToTickEnabled="True" TickFrequency="0.05"
                                    Value="{Binding Scale}" />
                        </DockPanel>

                        <TextBlock Grid.Row="3" Text="Duration" Style="{StaticResource FieldLabel}" />
                        <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,8">
                            <TextBox DockPanel.Dock="Right" Style="{StaticResource ValueBox}"
                                     Text="{Binding DurationSec, StringFormat=0.0}" ToolTip="Seconds" />
                            <Slider Minimum="0.5" Maximum="6" IsSnapToTickEnabled="True" TickFrequency="0.1"
                                    Value="{Binding DurationSec}" />
                        </DockPanel>

                        <DockPanel Grid.Row="5" Grid.ColumnSpan="2">
                            <Button DockPanel.Dock="Right" Click="Preview_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE890;" Margin="0,0,6,0" />
                                    <TextBlock Text="Preview" />
                                </StackPanel>
                            </Button>
                            <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,10,0"
                                       Text="Changes preview live on the selected monitor." />
                        </DockPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ================================ General ================================ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TabHeaderIcon}" Text="&#xE713;" />
                        <TextBlock Text="General" />
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250" />
                        <ColumnDefinition Width="29" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="STARTUP" Style="{StaticResource Caption}" Margin="2,6,0,10" />
                        <CheckBox Content="Start minimized to tray" IsChecked="{Binding StartMinimized}" />
                        <CheckBox Content="Run at Windows logon" IsChecked="{Binding RunAtLogon}" Margin="0,10,0,0" />

                        <TextBlock Text="TABLE DETECTION" Style="{StaticResource Caption}" Margin="2,22,0,8" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="A table counts as running while VPX shows its player window; its name comes from the “Visual Pinball - [table]” editor title. When the table is quit, the System volume is restored." />

                        <TextBlock Text="CONFIGURATION" Style="{StaticResource Caption}" Margin="2,22,0,8" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE838;"
                                    ToolTip="Open configuration folder" Click="OpenConfigFolder_Click" />
                            <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                       Text="{Binding ConfigPath, ElementName=Root}"
                                       ToolTip="{Binding ConfigPath, ElementName=Root}" />
                        </DockPanel>
                    </StackPanel>

                    <Rectangle Grid.Column="1" Style="{StaticResource VDivider}" />

                    <DockPanel Grid.Column="2">
                        <DockPanel DockPanel.Dock="Top" Margin="2,0,0,6">
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74D;"
                                    ToolTip="Forget the selected table's volumes" Click="Forget_Click" />
                            <TextBlock Text="SAVED TABLE VOLUMES" Style="{StaticResource Caption}" />
                        </DockPanel>
                        <Grid>
                            <ListBox x:Name="TableList" ItemsSource="{Binding Tables, ElementName=Root}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Margin="10,0,0,0"
                                                       Foreground="{StaticResource TextDimBrush}" />
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="Volumes are remembered per table&#x0a;as soon as you change them while playing."
                                       Visibility="Collapsed">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyHint}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Items.Count, ElementName=TableList}"
                                                         Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Title, sharing the row of the right-aligned tab strip -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Height="34" Margin="4,0,0,0"
                    IsHitTestVisible="False">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE767;" FontSize="18"
                       Foreground="{StaticResource AccentGradient}" />
            <TextBlock Text="Pincab Volume" FontSize="16" FontWeight="SemiBold" Margin="9,0,0,1"
                       VerticalAlignment="Center" />
        </StackPanel>

        <!-- Status bar -->
        <DockPanel Grid.Row="1" Margin="4,10,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Save &amp; hide"
                    Click="Save_Click" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource TextDimBrush}" />
                <TextBlock x:Name="ContextText" Margin="8,0,0,0" />
                <TextBlock Text="•" Margin="10,0" Foreground="{StaticResource BorderStrongBrush}" />
                <TextBlock x:Name="ActiveText" Foreground="{StaticResource TextDimBrush}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
